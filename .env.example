# ── Authentication (required in production) ────────────────────────────────
# Signs session cookies. Rotating it signs everyone out — that is how you revoke.
#   openssl rand -base64 32
SESSION_SECRET=

# Who can sign in, and which workspace each belongs to. JSON array.
# Mint entries with:  node scripts/make-user.mjs <email> "<name>" <workspace>
#
# ONE WORKSPACE PER CUSTOMER. The workspace is the tenant boundary: saved
# scenarios, working assumptions and imported datasets are scoped to it, so two
# customers on one deployment cannot see each other's work. Users sharing a
# workspace share their data — that is how you give a customer a team.
#
# AUTH_USERS=[{"email":"priya@maruti.co.in","name":"Priya","workspace":"maruti","passwordHash":"scrypt$..."}]
AUTH_USERS=

# Unset in local dev, both fall back to a built-in demo user (vijay@margin.io /
# marginio) with a warning. In production (VERCEL_ENV=production) an unset value
# is a hard failure rather than a silent default.

# ── AI analyst (optional) ──────────────────────────────────────────────────
# Turns on Ask AiRE, the co-pilot narrative layer and the forecast studio.
# These routes are session-gated and rate-limited per workspace.
ANTHROPIC_API_KEY=

# ── Data (optional) ────────────────────────────────────────────────────────
# Neon Postgres. Without it the local JSON file store is used (dev only —
# Vercel's filesystem is read-only, so serverless without Neon falls back to the
# bundled extract). Run `npm run db:setup` once after setting this.
DATABASE_URL=

# Gates POST /api/refresh, which rewrites the SHARED baseline every workspace
# falls back to. Unset is open in local dev and REFUSED in production.
CRON_SECRET=
